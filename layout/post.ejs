<article id="post">
    <h1 id="post-title"><%= page.title %></h1>
    <div id="post-memu" >
        <div class="post-date-cayegories">
            <div class="post-date">
                <a href="/archives<%= url_for(page.date.format('YYYY/MM')) %>" title="查看当月归档">
                <time id="post-date" datetime="<%=page.date.toJSON()%>">
                    <%=date(page.date, 'MMMM D, YYYY')%>
                </time>
                </a>
            </div>
            <div class="post-categories">
               <% for(let item of page.categories.data) { %>
                  <a href="<%= url_for(item.path)%>" title="<%- item.name %>">
                    <%- item.name %>
                  </a>
                <% } %>
            </div>
        </div>
    </div>
       
    <div id="post-content" class="markdown-body">
        <%- page.content %>
    </div> 
</article>

<div>
    <%- partial('_partials/pagination')%>
</div>

