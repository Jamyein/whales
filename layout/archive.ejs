  <div class="archivecs">
    <h3 class="widget-title"><%=page.year + '年' + page.month + '月'%></h3>
    <% page.posts.each(article => { %>
      <div class="archive-item">
        <a href="<%=url_for(article.path)%>\">
          <%=article.title%>
        </a>
        <time datetime="<%=date_xml(article.date)%>\">
          <%= date(article.date, 'MMMM D, YYYY') %>
        </time>
      </div>
    <% }); %>
  </div>
