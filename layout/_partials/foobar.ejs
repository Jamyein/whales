<!-- 页脚 -->
<div id="footer" class="footer">
    <%= theme.since && !isNaN(theme.since) && theme.since < date(new Date(), 'YYYY') ? theme.since + '-' : '' %><%= date(new Date(), 'YYYY') %> <%= config.title %>
    <% if(theme.link.enable) { %>
        <a href="<%=theme.link.rss%>">RSS</a>
        <a href="<%=theme.link.github%>">Github</a>
        <a href="<%=theme.link.about%>">About</a>
    <% } %>
</div>
